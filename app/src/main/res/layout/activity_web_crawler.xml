<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_main"
    android:padding="16dp">

    <!-- 顶部标题 -->
    <TextView
        android:id="@+id/tv_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/title_web_crawler"
        android:textColor="@color/text_white"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- 返回按钮 -->
    <ImageButton
        android:id="@+id/btn_back"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="返回"
        android:padding="8dp"
        android:src="@drawable/ic_undo"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="@color/text_white" />

    <!-- URL输入框 -->
    <EditText
        android:id="@+id/et_url"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_edittext"
        android:hint="@string/hint_url"
        android:inputType="textUri"
        android:padding="12dp"
        android:singleLine="true"
        android:textColor="@color/text_white"
        android:textColorHint="@color/text_secondary"
        android:textSize="14sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_title" />

    <!-- 请求方法选择 -->
    <Spinner
        android:id="@+id/spinner_method"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_spinner"
        android:padding="12dp"
        android:spinnerMode="dropdown"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/et_url" />

    <!-- 发送请求按钮 -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_send"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_marginStart="12dp"
        android:layout_marginTop="12dp"
        android:backgroundTint="@color/button_bg"
        android:text="@string/btn_send_request"
        android:textColor="@color/button_text"
        app:cornerRadius="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/spinner_method"
        app:layout_constraintTop_toBottomOf="@+id/et_url" />

    <!-- 请求头编辑区域标签 -->
    <TextView
        android:id="@+id/tv_headers_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="请求头（JSON格式）"
        android:textColor="@color/text_white"
        android:textSize="13sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/btn_send" />

    <!-- 请求头编辑区域 -->
    <EditText
        android:id="@+id/et_headers"
        android:layout_width="0dp"
        android:layout_height="80dp"
        android:layout_marginTop="4dp"
        android:background="@drawable/bg_edittext"
        android:gravity="top|start"
        android:hint='{"Content-Type": "application/json"}'
        android:inputType="textMultiLine"
        android:padding="12dp"
        android:textColor="@color/text_white"
        android:textColorHint="@color/text_secondary"
        android:textSize="12sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_headers_label" />

    <!-- 请求体编辑区域标签 -->
    <TextView
        android:id="@+id/tv_body_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="请求体（POST时填写）"
        android:textColor="@color/text_white"
        android:textSize="13sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/et_headers" />

    <!-- 请求体编辑区域 -->
    <EditText
        android:id="@+id/et_body"
        android:layout_width="0dp"
        android:layout_height="60dp"
        android:layout_marginTop="4dp"
        android:background="@drawable/bg_edittext"
        android:gravity="top|start"
        android:hint="@string/hint_request_body"
        android:inputType="textMultiLine"
        android:padding="12dp"
        android:textColor="@color/text_white"
        android:textColorHint="@color/text_secondary"
        android:textSize="12sp"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_body_label" />

    <!-- 响应状态码显示 -->
    <TextView
        android:id="@+id/tv_status_code"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="状态码: --"
        android:textColor="@color/accent"
        android:textSize="13sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/et_body" />

    <!-- 响应结果展示区域 -->
    <ScrollView
        android:id="@+id/sv_response"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_edittext"
        app:layout_constraintBottom_toTopOf="@+id/btn_save_result"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_status_code">

        <TextView
            android:id="@+id/tv_response"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="12dp"
            android:textColor="@color/text_white"
            android:textColorHint="@color/text_secondary"
            android:textSize="13sp"
            android:hint="响应结果将在此显示..." />
    </ScrollView>

    <!-- 保存结果按钮 -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_save_result"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_marginTop="12dp"
        android:backgroundTint="@color/button_bg"
        android:text="@string/btn_save"
        android:textColor="@color/button_text"
        app:cornerRadius="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/sv_response" />

</androidx.constraintlayout.widget.ConstraintLayout>
